  row -> t_wal [style=dotted, color="#CC79A7", label="one row each,\luntil it is sealed\l"];
  stream -> t_segments [style=dotted, color="#4D4D4D", label="just a column -\lin `segments` and in `wal`,\lgathered on read\l"];
