// GENERATED by `cargo run --example gen_diagrams` - do not edit.
// Source of truth: src/db.rs, src/writer.rs, src/read.rs, src/segment.rs.
digraph {
  label="dendro: the read path";
  labelloc=t;
  fontname="Helvetica";
  fontsize=20;
  rankdir=LR;
  bgcolor=white;
  node [fontname="Helvetica", fontsize=14, penwidth=1.4, color="#4D4D4D"];
  edge [fontname="Helvetica", fontsize=13, color="#4D4D4D", penwidth=1.4];
  nodesep=0.4;
  ranksep=0.75;
  sealed [shape=record, style=filled, fillcolor="#FBE3CB", label="seq 0|seq 1|seq 2"];
  live [shape=record, style=filled, fillcolor="#EDEDED", label="row|row"];
  watermark [shape=box, style="rounded,filled", fillcolor="#FFFF99", label="1. select live rows\n`ts > MAX(last_ts)`\nfor this stream, this source"];
  materialize [shape=box, style="rounded,filled", fillcolor="#FDC086", label="2. materialize the tail\n`SegmentEncoder`"];
  tail [shape=box, style="filled", fillcolor="#EDEDED", label="tail\nparquet bytes, in memory -\nnever written to the archive"];
  splice [shape=box, style="rounded,filled", fillcolor="#7FC97F", label="3. splice\noldest first, tail last"];
  bytes [shape=box, style="filled", fillcolor="#DDE4CF", label="parquet bytes\nopen with any reader"];
  live -> watermark [color="#CC79A7"];
  sealed -> watermark [style=dotted, label="MAX(last_ts)"];
  watermark -> materialize [color="#CC79A7", label="rows past\lthe watermark\l"];
  materialize -> tail [color="#CC79A7"];
  sealed -> splice [color="#D55E00", penwidth=2];
  tail -> splice [color="#CC79A7", penwidth=2];
  splice -> bytes [penwidth=2];
  subgraph cluster_yours {
    label="yours";
    fontsize=14;
    labeljust=l;
    style=dashed;
    color="#9E9E9E";
    materialize;
  }
  subgraph cluster_key {
    label="key";
    fontsize=13;
    labeljust=l;
    style=filled;
    fillcolor="#F2F2F2";
    color="#9E9E9E";
    node [fontsize=11, height=0.3];
    rank=same;
    k_sealed [shape=box, style=filled, fillcolor="#F2F2F2", color="#D55E00", penwidth=3, label="sealed"];
    k_unsealed [shape=box, style=filled, fillcolor="#F2F2F2", color="#CC79A7", penwidth=3, label="unsealed"];
    k_ext [shape=box, style="filled,dashed", fillcolor="#E6DEF2", label="dashed: outside dendro"];
    k_hist [shape=record, style=filled, fillcolor="#EDEDED", label="segmented: a history"];
    k_dat [shape=box, style=filled, fillcolor="#FBE3CB", label="square: holds"];
    k_op [shape=box, style="rounded,filled", fillcolor="#7FC97F", label="rounded: runs"];
  }
}
